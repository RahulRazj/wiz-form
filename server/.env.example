PORT=3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_TABLE=order_submissions
SUPABASE_BUCKET=order-submissions
ADMIN_SECRET_TOKEN=choose-a-long-random-admin-passcode

# Image cleanup: deletes order images from Supabase storage once they're older than
# IMAGE_CLEANUP_RETENTION_DAYS. 0 (default) disables the job. Checked every
# IMAGE_CLEANUP_INTERVAL_DAYS while the server is running; also triggerable via
# POST /api/admin/cleanup-images.
IMAGE_CLEANUP_RETENTION_DAYS=30
IMAGE_CLEANUP_INTERVAL_DAYS=14


# NCM Delivery Partner Configuration
NCM_API_KEY=your_ncm_api_token_here
NCM_API_URL=https://portal.nepalcanmove.com
NCM_API_TIMEOUT_MS=10000
NCM_WEBHOOK_SECRET=change-me-courier-webhook-secret

NCM_CREATE_ORDER_PATH=api/v1/order/create
